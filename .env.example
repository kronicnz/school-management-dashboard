VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_URL=http://localhost:5173

# Enables /sandbox and its mock personas, which replace your own identity with any
# of the ten role personas. Impersonation bypasses every client-side capability
# check, so only set this where that is intended.
#
# The dev server (`npm run dev`) always has it. Set this to true to get it on a
# built preview or staging bundle, for the ten-role walkthrough. Leave it unset
# in any environment a real user can reach: /sandbox then explains that it is
# switched off, and no persona can be selected.
# VITE_ENABLE_AUTH_SANDBOX=true

# Origin of the running app, read by the account-admin edge function to build the
# post-invitation redirect (APP_URL + /set-password). Must match VITE_APP_URL.
APP_URL=http://localhost:5173

# Provider key for Supabase auth mail (invitations and password resets).
# Never commit the real value: use `supabase secrets set SENDGRID_API_KEY=<value>`.
# Local development needs no key at all - Inbucket on http://localhost:54324
# captures the mail.
SENDGRID_API_KEY=your_sendgrid_api_key

# Finance intake and Gmail/Xero sync
FINANCE_GOOGLE_CLIENT_ID=your_gmail_client_id
FINANCE_GOOGLE_CLIENT_SECRET=your_gmail_client_secret
FINANCE_GOOGLE_REFRESH_TOKEN=your_gmail_refresh_token
XERO_CLIENT_ID=your_xero_client_id
XERO_CLIENT_SECRET=your_xero_client_secret
XERO_ACCESS_TOKEN=your_xero_access_token
XERO_REFRESH_TOKEN=your_xero_refresh_token
XERO_TENANT_ID=your_xero_tenant_id

# Gemini LLM models for invoice extraction
FINANCE_GEMINI_API_KEY=your_gemini_api_key
# Model for structured invoice data extraction from email + document text
FINANCE_GEMINI_REVIEW_MODEL=gemini-3.5-flash
# Model for reading the invoice PDF directly (multimodal, keeps table layout intact)
FINANCE_GEMINI_OCR_MODEL=gemini-3.5-flash-lite
# Model for structured, column-aware reading of the PDF page. Needs to be strong
# enough to keep Item ID / UoM columns out of the line item descriptions.
# Defaults to FINANCE_GEMINI_REVIEW_MODEL when unset.
FINANCE_GEMINI_VISION_MODEL=gemini-3.5-flash
# Second model in the retry chain
FINANCE_GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Default Xero expense account code applied to bill lines that carry no
# explicit account code from the invoice
XERO_ACCOUNT_CODE=400
